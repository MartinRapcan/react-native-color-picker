{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "lib/",
    "node_modules/",
    "coverage/",
    "bun.lock",
    "example/.expo/"
  ],
  "endOfLine": "lf"
}
